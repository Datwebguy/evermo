{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "NIXPACKS", "buildCommand": "npm ci --workspace @evermo/service --include-workspace-root" },
  "deploy": {
    "startCommand": "npm run start --workspace @evermo/service",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
